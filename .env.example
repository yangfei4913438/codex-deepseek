# DeepSeek API key (required)
api_key=sk-your-deepseek-api-key

# API base URL (optional, default: https://api.deepseek.com)
base_url=https://api.deepseek.com

# Model name (optional, default: deepseek-v4-pro)
model=deepseek-v4-pro

# Multimodal support (optional, default: false)
# Set to true if your model supports image_url inputs
# multimodal=true

# Server port (optional, default: 11435)
# port=11435
