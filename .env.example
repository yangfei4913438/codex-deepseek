# DeepSeek API key (required)
api_key=sk-your-deepseek-api-key

# API base URL
base_url=https://api.deepseek.com

# Model name
model=deepseek-v4-pro

# Server port
port=11435

# Upstream API timeout in minutes (default: 30)
timeout=30

# Set to false if the target model is not a DeepSeek model
is_deepseek=true

# Multimodal support: set to true if your model supports image inputs
multimodal=false

# Identity name injected into system prompt (optional)
#
# When the proxy injects model identity, it uses this name.
# - Leave empty if model is already the official model name (e.g. deepseek-v4-pro)
# - Set this only when model is a third-party routing identifier,
#   e.g. model=deepseek-ai/DeepSeek-V4-Pro -> identity_model=deepseek-v4-pro
identity_model=
